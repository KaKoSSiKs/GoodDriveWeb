# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# MySQL Root Password (��� ����������������� �������)
# �����: ����������� ������� ������ � production!
MYSQL_ROOT_PASSWORD=rootpassword

# MySQL Database Name
MYSQL_DATABASE=gooddrive_db

# MySQL User (��� ����������)
MYSQL_USER=gooddrive_user

# MySQL Password (��� ����������)
# �����: ����������� ������� ������ � production!
MYSQL_PASSWORD=gooddrive_password

# Database URL (������������� ����������� �� ���������� ����)
# ��� Docker �����������: mysql://MYSQL_USER:MYSQL_PASSWORD@localhost:3306/MYSQL_DATABASE
# ��� ��������� ����������: mysql://MYSQL_USER:MYSQL_PASSWORD@localhost:3306/MYSQL_DATABASE
# ����� ������� �������, ���� ����� ��������� ������������
DATABASE_URL="mysql://gooddrive_user:gooddrive_password@127.0.0.1:3306/gooddrive_db"
# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Node Environment (development | production)
NODE_ENV=production

# Application Port (�� ��������� 3000)
PORT=3000

# =============================================================================
# SECURITY
# =============================================================================

# JWT Secret Key (�����������!)
# �����: ����������� ������� ��������� ���� ������� 32 �������
# �������������: openssl rand -base64 64
# ������� �� ����������� ��������� �������� � production!
JWT_SECRET=your-secret-key-change-in-production-generate-with-openssl-rand-base64-64

# JWT Token Expiration (�����������, �� ��������� 7d)
# ������: ����� + ������� ������� (s, m, h, d)
# �������: 1h, 7d, 30d
JWT_EXPIRES_IN=7d

# =============================================================================
# PUBLIC VARIABLES (Build Time)
# =============================================================================
# ��� ���������� ������������ �� ����� ������ SvelteKit
# ������� PUBLIC_ ��������, ��� ��� �������� � ���������� ����
# =============================================================================

# Site URL (������������ ��� sitemap, RSS, SEO)
# � development: http://localhost:3000
# � production: https://your-domain.com
PUBLIC_SITE_URL=https://nikitintex.ru

# Yandex Metrika Counter ID (�����������)
# ��������: https://metrika.yandex.ru/
PUBLIC_YM_COUNTER_ID=105482233

# Google Analytics 4 ID (�����������)
# ������: G-XXXXXXXXXX
PUBLIC_GA4_ID=

# Google Search Console Verification Code (�����������)
# ��� ����������� ����� � Google Search Console
PUBLIC_GOOGLE_VERIFICATION=

# Yandex Webmaster Verification Code (�����������)
