PUBLIC_YANDEX_VERIFICATION=256f12d3b93a3ebb

# =============================================================================
# FEATURES & OPTIONS
# =============================================================================

# Enable Auth Rate Limiting (�����������)
# �� ��������� rate limiting �������� � development ��� �������� ������������
# ���������� true ��� ��������� rate limiting ��� �����������
ENABLE_AUTH_RATE_LIMIT=false

# Log Level (�����������)
# ������: debug, info, warn, error
# � development �� ���������: debug
# � production �� ���������: info
LOG_LEVEL=

# =============================================================================
# DATA IMPORT
# =============================================================================

# Import Limit (�����������)
# ����� �� ���������� ������������� ����� �� CSV
# 0 = ������������� ��� ������ (4000+)
# 100 = ������������� ������ 100 ����� (��� �����)
IMPORT_LIMIT=0

# Force Import (�����������)
# �������������� ������ ������, ���� ���� ��� ��� ���� � ��
# true = �������������� ������
# false = ���������� ������, ���� ������ ��� ����
FORCE_IMPORT=false

