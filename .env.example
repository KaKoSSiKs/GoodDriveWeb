# =============================================================================
# GoodDrive - Environment Variables
# =============================================================================
# Скопируйте этот файл в .env и заполните значения
# cp .env.example .env
# =============================================================================

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# MySQL Root Password (для административного доступа)
# ВАЖНО: Используйте сильный пароль в production!
MYSQL_ROOT_PASSWORD=rootpassword

# MySQL Database Name
MYSQL_DATABASE=gooddrive_db

# MySQL User (для приложения)
MYSQL_USER=gooddrive_user

# MySQL Password (для приложения)
# ВАЖНО: Используйте сильный пароль в production!
MYSQL_PASSWORD=gooddrive_password

# Database URL (автоматически формируется из переменных выше)
# Для Docker используйте: mysql://MYSQL_USER:MYSQL_PASSWORD@mysql:3306/MYSQL_DATABASE
# Для локальной разработки: mysql://MYSQL_USER:MYSQL_PASSWORD@localhost:3306/MYSQL_DATABASE
# Можно указать вручную, если нужна кастомная конфигурация
DATABASE_URL=mysql://gooddrive_user:gooddrive_password@mysql:3306/gooddrive_db

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Node Environment (development | production)
NODE_ENV=production

# Application Port (по умолчанию 3000)
PORT=3000

# =============================================================================
# SECURITY
# =============================================================================

# JWT Secret Key (ОБЯЗАТЕЛЬНО!)
# ВАЖНО: Используйте сильный случайный ключ минимум 32 символа
# Сгенерировать: openssl rand -base64 64
# НИКОГДА не используйте дефолтное значение в production!
JWT_SECRET=your-secret-key-change-in-production-generate-with-openssl-rand-base64-64

# JWT Token Expiration (опционально, по умолчанию 7d)
# Формат: число + единица времени (s, m, h, d)
# Примеры: 1h, 7d, 30d
JWT_EXPIRES_IN=7d

# =============================================================================
# PUBLIC VARIABLES (Build Time)
# =============================================================================
# Эти переменные используются во время сборки SvelteKit
# Префикс PUBLIC_ означает, что они доступны в клиентском коде
# =============================================================================

# Site URL (используется для sitemap, RSS, SEO)
# В development: http://localhost:3000
# В production: https://your-domain.com
PUBLIC_SITE_URL=http://localhost

# Yandex Metrika Counter ID (опционально)
# Получить: https://metrika.yandex.ru/
PUBLIC_YM_COUNTER_ID=

# Google Analytics 4 ID (опционально)
# Формат: G-XXXXXXXXXX
PUBLIC_GA4_ID=

# Google Search Console Verification Code (опционально)
# Для верификации сайта в Google Search Console
PUBLIC_GOOGLE_VERIFICATION=

# Yandex Webmaster Verification Code (опционально)
# Для верификации сайта в Yandex Webmaster
PUBLIC_YANDEX_VERIFICATION=

# =============================================================================
# FEATURES & OPTIONS
# =============================================================================

# Enable Auth Rate Limiting (опционально)
# По умолчанию rate limiting отключен в development для удобства тестирования
# Установите true для включения rate limiting для авторизации
ENABLE_AUTH_RATE_LIMIT=false

# Log Level (опционально)
# Уровни: debug, info, warn, error
# В development по умолчанию: debug
# В production по умолчанию: info
LOG_LEVEL=

# =============================================================================
# DATA IMPORT
# =============================================================================

# Import Limit (опционально)
# Лимит на количество импортируемых строк из CSV
# 0 = импортировать все строки (4000+)
# 100 = импортировать первые 100 строк (для теста)
IMPORT_LIMIT=0

# Force Import (опционально)
# Принудительный импорт данных, даже если они уже есть в БД
# true = принудительный импорт
# false = пропустить импорт, если данные уже есть
FORCE_IMPORT=false

# =============================================================================
# NOTES
# =============================================================================
# 
# 1. Все переменные с префиксом PUBLIC_ доступны в клиентском коде
# 2. JWT_SECRET должен быть уникальным и безопасным в production
# 3. DATABASE_URL автоматически формируется из MYSQL_* переменных в docker-compose
# 4. Для локальной разработки без Docker укажите DATABASE_URL вручную
# 5. Не коммитьте .env файл в Git (он уже в .gitignore)
# 
# =============================================================================
